{
  "name": "evening-party-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "emulators": "firebase emulators:start --project demo-party --import=../../work/emulator-data --export-on-exit=../../work/emulator-data",
    "emulators:fresh": "firebase emulators:start --project demo-party",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/integration.mjs",
    "test:production": "node tests/production-smoke.mjs",
    "test:browser": "node tests/browser.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 15174 --strictPort",
    "test:pwa": "node tests/pwa.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "firebase-tools": "13.35.1",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "tar": "7.5.22",
    "qs": "6.16.0"
  }
}
